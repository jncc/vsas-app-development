        <default applyOnUpdate="1" expression="if(&quot;survey_id&quot; is not NULL, if(&quot;trip&quot; IS NULL, if(maximum(&quot;trip&quot;,group_by:=&quot;survey_id&quot;) IS NULL, 1, maximum(&quot;trip&quot;,group_by:=&quot;survey_id&quot;)+1) ,&quot;trip&quot;),&quot;trip&quot;)" field="trip"/>
