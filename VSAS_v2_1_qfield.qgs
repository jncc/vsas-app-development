                  <Option type="Map">
                    <Option type="QString" value="4" name="All species except Larus gulls, fulmars and kittiwakes"/>
                  </Option>
                  <Option type="Map">
                    <Option type="QString" value="5" name="Auks only"/>
                  </Option>
                  <Option type="Map">
                    <Option type="QString" value="6" name="Auks and seaduck only"/>
                  </Option>
                  <Option type="Map">
                    <Option type="QString" value="7" name="All species except eiders and gulls"/>
                  </Option>
                  <Option type="Map">
                    <Option type="QString" value="8" name="All species except gannets"/>
                  </Option>
                  <Option type="Map">
                    <Option type="QString" value="9" name="Auks and unusual seabirds only"/>
                  </Option>
                </Option>
              </Option>
            </config>
          </editWidget>
        </field>
